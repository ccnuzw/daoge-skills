{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daoge-docs.local/schemas/requirements.schema.json",
  "title": "DAOGE Docs NFR/RG 需求注册表",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "status", "source", "verification", "updated"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,11}-(NFR|RG)-[0-9]{3}$"},
          "type": {"enum": ["NFR", "RG"]},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["planning", "draft", "ready", "deprecated"]},
          "source": {"type": "string", "minLength": 1},
          "verification": {"type": "string", "minLength": 1},
          "updated": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
