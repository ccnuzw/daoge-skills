#!/usr/bin/env node

/**
 * 文档浏览器生成器 - 增强版 v2.0
 * 新增功能：
 * - 动态生成版本演进图谱（SVG）
 * - 动态生成数据域关系图
 * - 动态生成功能时间线
 * - 动态生成风险热区图
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const DOCS_ROOT = path.join(process.cwd(), 'docs');
const OUTPUT_HTML = path.join(DOCS_ROOT, '90-参考资料/产品文档浏览器.html');
const OUTPUT_DATA = path.join(DOCS_ROOT, '90-参考资料/产品文档浏览器-文档数据.js');
const TEMPLATE_PATH = path.join(__dirname, '../templates/browser-template.html');

/**
 * 扫描目录下所有 markdown 文件
 */
function scanDocs(dir, baseDir = dir) {
  const results = [];
  const items = fs.readdirSync(dir, { withFileTypes: true });

  for (const item of items) {
    const fullPath = path.join(dir, item.name);
    const relativePath = path.relative(baseDir, fullPath);

    if (item.isDirectory()) {
      results.push(...scanDocs(fullPath, baseDir));
    } else if (item.isFile() && item.name.endsWith('.md')) {
      const content = fs.readFileSync(fullPath, 'utf-8');
      const titleMatch = content.match(/^#\s+(.+)$/m);
      const title = titleMatch ? titleMatch[1].trim() : item.name.replace('.md', '');
      
      results.push({
        path: relativePath,
        title: title,
        content: content
      });
    }
  }

  return results;
}

/**
 * 从版本路线图中提取版本信息
 */
function extractVersions(docs) {
  const versionDoc = docs.find(d => d.path.includes('版本路线图') || d.path.includes('版本总览'));
  if (!versionDoc) return [];

  const versions = [];
  const lines = versionDoc.content.split('\n');
  
  // 匹配版本标题，例如：## V1 基础平台、### V2 稳定网关
  const versionRegex = /^##\s+(V\d+)[\s:：](.+)/;
  
  for (const line of lines) {
    const match = line.match(versionRegex);
    if (match) {
      versions.push({
        id: match[1],
        name: match[2].trim()
      });
    }
  }

  return versions;
}

/**
 * 从功能规格中提取功能列表
 */
function extractFeatures(docs) {
  const features = [];
  
  // 查找所有功能规格文档
  const featureDocs = docs.filter(d => 
    d.path.includes('03-功能规格') && 
    !d.path.includes('README') &&
    !d.path.includes('功能开发流程') &&
    !d.path.includes('功能文档规范')
  );

  for (const doc of featureDocs) {
    // 提取功能编号，例如：V1-FR-001
    const idMatch = doc.content.match(/(V\d+-FR-\d+)/);
    if (!idMatch) continue;


/**
 * 从数据模型文档中提取表关系
 */
function extractDataRelationships(docs) {
  const dataModelDoc = docs.find(d => 
    d.path.includes('数据模型') || 
    d.path.includes('data-model') ||
    d.title.includes('数据模型')
  );
  
  if (!dataModelDoc) return [];
  
  const relationships = [];
  const content = dataModelDoc.content;
  
  // 方法1：从 Mermaid ER 图中提取关系
  const mermaidMatch = content.match(/```mermaid\s+erDiagram([\s\S]*?)```/);
  if (mermaidMatch) {
    const mermaidContent = mermaidMatch[1];
    // 匹配关系，例如：USERS ||--o{ API_KEYS : owns
    const relationRegex = /(\w+)\s+([\|\}o]{2}--[\|\{o]{2})\s+(\w+)\s*:\s*(\w+)/g;
    let match;
    while ((match = relationRegex.exec(mermaidContent)) !== null) {
      relationships.push({
        from: match[1],
        to: match[3],
        type: match[2],
        label: match[4]
      });
    }
  }
  
  // 方法2：从文本描述中提取（如果没有 Mermaid）
  if (relationships.length === 0) {
    const lines = content.split('\n');
    for (const line of lines) {
      // 匹配类似 "users 表与 api_keys 表是一对多关系"
      const textMatch = line.match(/(\w+).*与.*(\w+).*一对多|(\w+).*关联.*(\w+)/);
      if (textMatch) {
        relationships.push({
          from: textMatch[1] || textMatch[3],
          to: textMatch[2] || textMatch[4],
          type: '||--o{',
          label: 'relates'
        });
      }
    }
  }
  
  return relationships;
}

/**
 * 从功能演进矩阵中提取演进数据
 */
function extractFeatureEvolution(docs) {
  const evolutionDoc = docs.find(d => 
    d.path.includes('功能演进') || 
    d.path.includes('feature-evolution') ||
    d.title.includes('功能演进')
  );
  
  if (!evolutionDoc) return [];
  
  const evolutions = [];
  const content = evolutionDoc.content;
  const lines = content.split('\n');
  
  // 查找表格
  let inTable = false;
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    
    // 表格开始
    if (line.startsWith('|') && line.includes('能力主线') && lines[i + 1]?.includes('---')) {
      inTable = true;
      i++; // 跳过分隔行
      continue;
    }
    
    // 表格内容
    if (inTable && line.startsWith('|')) {
      if (line.includes('---')) continue; // 跳过分隔行
      
      const cells = line.split('|').map(c => c.trim()).filter(c => c);
      if (cells.length >= 4) {
        evolutions.push({
          capability: cells[0],
          v1: cells[1] || '',
          v2: cells[2] || '',
          v3: cells[3] || '',
          description: cells[4] || ''
        });
      }
    }
    
    // 表格结束
    if (inTable && !line.startsWith('|')) {
      inTable = false;
    }
  }
  
  return evolutions;
}

/**
 * 生成数据域关系图 SVG
 */
function generateDataRelationshipSVG(relationships) {
  if (relationships.length === 0) return '';
  
  // 提取所有表名
  const tables = new Set();
  relationships.forEach(rel => {
    tables.add(rel.from);
    tables.add(rel.to);
  });
  
  const tableArray = Array.from(tables);
  const tableCount = tableArray.length;
  
  // 计算布局
  const cols = Math.ceil(Math.sqrt(tableCount));
  const rows = Math.ceil(tableCount / cols);
  const boxWidth = 120;
  const boxHeight = 50;
  const gapX = 40;
  const gapY = 60;
  const startX = 50;
  const startY = 80;
  
  const width = startX * 2 + cols * boxWidth + (cols - 1) * gapX;
  const height = startY + rows * boxHeight + (rows - 1) * gapY + 50;
  
  // 表的位置映射
  const tablePositions = {};
  tableArray.forEach((table, index) => {
    const col = index % cols;
    const row = Math.floor(index / cols);
    tablePositions[table] = {
      x: startX + col * (boxWidth + gapX),
      y: startY + row * (boxHeight + gapY),
      cx: startX + col * (boxWidth + gapX) + boxWidth / 2,
      cy: startY + row * (boxHeight + gapY) + boxHeight / 2
    };
  });
  
  let svg = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" style="max-width: 100%; height: auto;">
  <defs>
    <style>
      .table-box { fill: #e6e9f6; stroke: #4056a1; stroke-width: 2; }
      .table-name { font-family: monospace; font-size: 12px; font-weight: 600; fill: #1d1f22; }
      .relation-line { stroke: #69707a; stroke-width: 1.5; fill: none; }
      .relation-label { font-family: sans-serif; font-size: 10px; fill: #69707a; }
    </style>
    <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#69707a" />
    </marker>
  </defs>
  
  <text x="${width / 2}" y="40" text-anchor="middle" style="font-size: 18px; font-weight: 700; fill: #1d1f22;">数据域关系图</text>
  <text x="${width / 2}" y="60" text-anchor="middle" style="font-size: 12px; fill: #69707a;">从数据模型文档自动生成</text>
`;
  
  // 绘制关系线
  relationships.forEach(rel => {
    const from = tablePositions[rel.from];
    const to = tablePositions[rel.to];
    if (!from || !to) return;
    
    // 简单的直线连接（可以改进为更智能的路径）
    svg += `<line x1="${from.cx}" y1="${from.cy}" x2="${to.cx}" y2="${to.cy}" class="relation-line" marker-end="url(#arrowhead)" />`;
    
    // 关系标签
    const midX = (from.cx + to.cx) / 2;
    const midY = (from.cy + to.cy) / 2;
    svg += `<text x="${midX}" y="${midY - 5}" text-anchor="middle" class="relation-label">${rel.label}</text>`;
  });
  
  // 绘制表框
  tableArray.forEach(table => {
    const pos = tablePositions[table];
    svg += `<rect x="${pos.x}" y="${pos.y}" width="${boxWidth}" height="${boxHeight}" rx="6" class="table-box" />`;
    svg += `<text x="${pos.cx}" y="${pos.cy + 5}" text-anchor="middle" class="table-name">${table.toLowerCase()}</text>`;
  });
  
  svg += '</svg>';
  return svg;
}

/**
 * 生成功能演进矩阵 SVG
 */
function generateFeatureEvolutionSVG(evolutions) {
  if (evolutions.length === 0) return '';
  
  const width = 900;
  const rowHeight = 50;
  const headerHeight = 80;
  const height = headerHeight + evolutions.length * rowHeight + 50;
  
  const colWidths = [200, 200, 200, 200];
  const colHeaders = ['能力主线', 'V1', 'V2', 'V3'];
  
  let svg = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" style="max-width: 100%; height: auto;">
  <defs>
    <style>
      .header-bg { fill: #4056a1; }
      .header-text { font-family: sans-serif; font-size: 14px; font-weight: 600; fill: #ffffff; }
      .row-bg-odd { fill: #f9fafb; }
      .row-bg-even { fill: #ffffff; }
      .cell-text { font-family: sans-serif; font-size: 11px; fill: #1d1f22; }
      .grid-line { stroke: #dedbd2; stroke-width: 1; }
    </style>
  </defs>
  
  <text x="${width / 2}" y="30" text-anchor="middle" style="font-size: 18px; font-weight: 700; fill: #1d1f22;">功能演进矩阵</text>
  <text x="${width / 2}" y="50" text-anchor="middle" style="font-size: 12px; fill: #69707a;">从功能演进矩阵文档自动生成</text>
`;
  
  // 表头
  svg += `<rect x="20" y="${headerHeight}" width="${colWidths.reduce((a, b) => a + b)}" height="40" class="header-bg" />`;
  
  let colX = 20;
  colHeaders.forEach((header, i) => {
    svg += `<text x="${colX + colWidths[i] / 2}" y="${headerHeight + 25}" text-anchor="middle" class="header-text">${header}</text>`;
    colX += colWidths[i];
  });
  
  // 数据行
  evolutions.forEach((evo, rowIndex) => {
    const y = headerHeight + 40 + rowIndex * rowHeight;
    const bgClass = rowIndex % 2 === 0 ? 'row-bg-even' : 'row-bg-odd';
    
    svg += `<rect x="20" y="${y}" width="${colWidths.reduce((a, b) => a + b)}" height="${rowHeight}" class="${bgClass}" />`;
    
    // 单元格内容
    const cells = [evo.capability, evo.v1, evo.v2, evo.v3];
    colX = 20;
    cells.forEach((cell, i) => {
      // 文本换行处理（简化版）
      const maxChars = 20;
      const text = cell.length > maxChars ? cell.substring(0, maxChars) + '...' : cell;
      svg += `<text x="${colX + 10}" y="${y + rowHeight / 2 + 4}" class="cell-text">${text}</text>`;
      colX += colWidths[i];
    });
  });
  
  // 网格线
  colX = 20;
  colWidths.forEach(width => {
    colX += width;
    svg += `<line x1="${colX}" y1="${headerHeight}" x2="${colX}" y2="${headerHeight + 40 + evolutions.length * rowHeight}" class="grid-line" />`;
  });
  
  svg += '</svg>';
  return svg;
}
    
