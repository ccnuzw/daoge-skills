{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daoge-docs.local/schemas/project-inputs.schema.json",
  "title": "DAOGE Docs 项目输入与约束注册表",
  "type": "object",
  "required": ["schema_version", "inputs", "constraints", "evidence_assets", "coverage", "authority_scopes", "approvals", "change_sets", "delivery_units", "delivery_records", "spec_drafts"],
  "properties": {
    "schema_version": {"const": 6},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/input"}
    },
    "constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/constraint"}
    },
    "evidence_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_asset"}
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    },
    "authority_scopes": {
      "type": "array",
      "items": {"$ref": "#/$defs/authority_scope"}
    },
    "approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/approval"}
    },
    "change_sets": {
      "type": "array",
      "items": {"$ref": "#/$defs/change_set"}
    },
    "delivery_units": {
      "type": "array",
      "items": {"$ref": "#/$defs/delivery_unit"}
    },
    "delivery_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/delivery_record"}
    },
    "spec_drafts": {
      "type": "array",
      "items": {"$ref": "#/$defs/spec_draft"}
    }
  },
  "$defs": {
    "timestamp": {
      "type": ["string", "null"]
    },
    "input": {
      "type": "object",
      "required": ["id", "title", "summary", "status", "source_kind", "source_ref", "confirmed_by", "confirmed_at", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^INPUT-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "status": {"enum": ["observed", "confirmed", "rejected", "superseded"]},
        "source_kind": {"enum": ["stakeholder_statement", "repository", "external_reference", "experiment", "other"]},
        "source_ref": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"$ref": "#/$defs/timestamp"},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "constraint": {
      "type": "object",
      "required": ["id", "title", "kind", "value", "source_input", "status", "confirmed_by", "confirmed_at", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^CONSTRAINT-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["hard_requirement", "soft_goal", "reference_observation"]},
        "value": {"type": "string", "minLength": 1},
        "source_input": {"type": "string", "pattern": "^(none|INPUT-[0-9]{3})$"},
        "status": {"enum": ["observed", "confirmed", "rejected", "superseded"]},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"$ref": "#/$defs/timestamp"},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "evidence_asset": {
      "type": "object",
      "required": ["id", "title", "kind", "source_input", "source_ref", "redacted", "status", "path", "sha256", "missing_reason", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^ASSET-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["image", "document", "archive", "recording", "binary", "other"]},
        "source_input": {"type": "string", "pattern": "^(none|INPUT-[0-9]{3})$"},
        "source_ref": {"type": "string", "minLength": 1},
        "redacted": {"type": "boolean"},
        "status": {"enum": ["available", "missing_source_asset"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "missing_reason": {"type": ["string", "null"]},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["id", "source_id", "disposition", "version", "requirement_ids", "feature_ids", "e2e_ids", "future_plan", "rationale", "confirmed_by", "confirmed_at", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^COVERAGE-[0-9]{3}$"},
        "source_id": {"type": "string", "pattern": "^(INPUT|CONSTRAINT)-[0-9]{3}$"},
        "disposition": {"enum": ["current_scope", "future_candidate", "rejected", "superseded", "not_applicable"]},
        "version": {"type": ["string", "null"]},
        "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "feature_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "e2e_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "future_plan": {"type": ["string", "null"]},
        "rationale": {"type": ["string", "null"]},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"$ref": "#/$defs/timestamp"},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "authority_scope": {
      "type": "object",
      "required": ["id", "scope", "fact_type", "source", "owner", "status", "supersedes", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^AUTH-[0-9]{3}$"},
        "scope": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
        "fact_type": {"enum": ["product_direction", "cross_version_constraint", "version_scope", "version_requirement", "feature_behavior", "system_architecture", "api_schema", "data_physical_schema", "data_semantics", "implementation", "test_strategy", "security_baseline", "release_eligibility"]},
        "source": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "deprecated"]},
        "supersedes": {"type": ["string", "null"], "pattern": "^AUTH-[0-9]{3}$"},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "required": ["id", "scope", "version", "title", "status", "authority_digest", "requested_by", "requested_at", "confirmed_by", "confirmed_at", "rationale", "supersedes", "superseded_by", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^APPROVAL-[0-9]{3}$"},
        "scope": {"const": "version_scope"},
        "version": {"type": "string", "pattern": "^V[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "approved", "rejected", "superseded"]},
        "authority_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "requested_by": {"type": "string", "minLength": 1},
        "requested_at": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"$ref": "#/$defs/timestamp"},
        "rationale": {"type": "string", "minLength": 1},
        "supersedes": {"type": ["string", "null"], "pattern": "^APPROVAL-[0-9]{3}$"},
        "superseded_by": {"type": ["string", "null"], "pattern": "^APPROVAL-[0-9]{3}$"},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "change_set": {
      "type": "object",
      "required": ["id", "version", "kind", "title", "status", "authority_digest", "affected_ids", "source_paths", "requested_by", "requested_at", "confirmed_by", "confirmed_at", "rationale", "decision_rationale", "supersedes", "superseded_by", "events", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^CHANGESET-[0-9]{3}$"},
        "version": {"type": "string", "pattern": "^V[0-9]+$"},
        "kind": {"enum": ["add", "change", "deprecate", "split", "defer"]},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "approved", "rejected", "superseded", "cancelled"]},
        "authority_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}},
        "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requested_by": {"type": "string", "minLength": 1},
        "requested_at": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"$ref": "#/$defs/timestamp"},
        "rationale": {"type": "string", "minLength": 1},
        "decision_rationale": {"type": ["string", "null"]},
        "supersedes": {"type": ["string", "null"], "pattern": "^CHANGESET-[0-9]{3}$"},
        "superseded_by": {"type": ["string", "null"], "pattern": "^CHANGESET-[0-9]{3}$"},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "actor", "at", "rationale"],
            "properties": {
              "status": {"enum": ["proposed", "approved", "rejected", "superseded", "cancelled"]},
              "actor": {"type": "string", "minLength": 1},
              "at": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "delivery_unit": {
      "type": "object",
      "required": ["id", "kind", "version", "title", "status", "feature_ids", "source_paths", "owner", "superseded_by", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^MODULE-[A-Z0-9][A-Z0-9-]*$"},
        "kind": {"const": "module"},
        "version": {"type": "string", "pattern": "^V[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "deprecated"]},
        "feature_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "superseded_by": {"type": ["string", "null"], "pattern": "^MODULE-[A-Z0-9][A-Z0-9-]*$"},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "delivery_record": {
      "type": "object",
      "required": ["id", "target_id", "target_kind", "version", "feature_ids", "decision", "scope_digest", "goal_ids", "goal_completion_digests", "confirmed_by", "confirmed_at", "rationale", "supersedes", "superseded_by", "events", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^DELIVERY-[0-9]{3}$"},
        "target_id": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["feature", "module", "version"]},
        "version": {"type": "string", "pattern": "^V[0-9]+$"},
        "feature_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decision": {"enum": ["accepted", "exception"]},
        "scope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "goal_ids": {"type": "array", "items": {"type": "string", "pattern": "^GOAL-[A-Z0-9][A-Z0-9-]*$"}},
        "goal_completion_digests": {"type": "array", "items": {"type": "object", "required": ["goal_id", "completion_digest"], "properties": {"goal_id": {"type": "string", "pattern": "^GOAL-[A-Z0-9][A-Z0-9-]*$"}, "completion_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "supersedes": {"type": ["string", "null"], "pattern": "^DELIVERY-[0-9]{3}$"},
        "superseded_by": {"type": ["string", "null"], "pattern": "^DELIVERY-[0-9]{3}$"},
        "events": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["decision", "actor", "at", "rationale"], "properties": {"decision": {"enum": ["accepted", "exception", "superseded"]}, "actor": {"type": "string", "minLength": 1}, "at": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}}},
        "updated": {"type": "string", "minLength": 1}
      }
    },
    "spec_draft": {
      "type": "object",
      "required": ["id", "version", "kind", "title", "status", "target_path", "target_digest", "content_digest", "requested_by", "requested_at", "confirmed_by", "confirmed_at", "rationale", "decision_rationale", "materialized_by", "materialized_at", "materialized_target_digest", "supersedes", "superseded_by", "events", "updated"],
      "properties": {
        "id": {"type": "string", "pattern": "^SPEC-DRAFT-[0-9]{3}$"},
        "version": {"type": "string", "pattern": "^V[0-9]+$"},
        "kind": {"enum": ["create", "replace"]},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "approved", "rejected", "materialized", "superseded"]},
        "target_path": {"type": "string", "minLength": 1},
        "target_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "requested_by": {"type": "string", "minLength": 1},
        "requested_at": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"$ref": "#/$defs/timestamp"},
        "rationale": {"type": "string", "minLength": 1},
        "decision_rationale": {"type": ["string", "null"]},
        "materialized_by": {"type": ["string", "null"]},
        "materialized_at": {"$ref": "#/$defs/timestamp"},
        "materialized_target_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "supersedes": {"type": ["string", "null"], "pattern": "^SPEC-DRAFT-[0-9]{3}$"},
        "superseded_by": {"type": ["string", "null"], "pattern": "^SPEC-DRAFT-[0-9]{3}$"},
        "events": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["status", "actor", "at", "rationale"], "properties": {"status": {"enum": ["proposed", "approved", "rejected", "materialized", "superseded"]}, "actor": {"type": "string", "minLength": 1}, "at": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}}},
        "updated": {"type": "string", "minLength": 1}
      }
    }
  }
}
