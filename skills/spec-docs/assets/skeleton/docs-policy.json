  "featureDoc": {
    "dir": "03-功能规格/{{活跃版本}}",
    "filePattern": "^\\d{2}-.+\\.md$",
    "excludePattern": "(^00-)|(^README\\.md$)|(-技术设计\\.md$)",
    "sections": [
      "目标",
      "功能边界",
      "需求说明",
      "接口契约",
      "数据与事务",
      "验收标准",
      "实现与验证"
    ],
    "statusValues": ["规划中", "开发中", "部分实现", "基础实现", "本地验证", "待验收", "已完成", "阻塞"],
    "acColumns": ["测试层级", "目标资产", "目标命令"]
  },
  "ids": {
    "requirement": "V\\d+-FR-\\d{3}",
    "nfr": "V\\d+-NFR-\\d{3}",
    "releaseGate": "V\\d+-RG-\\d{3}",
    "e2e": "V\\d+-E2E-\\d{2}",
    "acceptance": "AC\\d{2}",
    "branch": "B\\d+-\\d{2}",
    "decision": "D\\d{3}"
  },
  "indexes": [
    "03-功能规格/{{活跃版本}}/README.md",
    "03-功能规格/{{活跃版本}}/功能查找表.md",
    "03-功能规格/{{活跃版本}}/技术设计索引.md"
