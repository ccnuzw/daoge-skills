#!/usr/bin/env node

/**
 * 文档浏览器生成器 v4.0 - 真正定制化版本
 * 
 * 核心改进：
 * 1. 深度分析文档结构，提取所有关键数据
 * 2. 动态生成所有数据结构（不使用硬编码）
 * 3. 根据实际文档内容定制浏览器
 * 4. 自动识别项目结构和版本体系
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const DOCS_ROOT = path.join(process.cwd(), 'docs');
const OUTPUT_HTML = path.join(DOCS_ROOT, '90-参考资料/产品文档浏览器.html');
const OUTPUT_DATA = path.join(DOCS_ROOT, '90-参考资料/产品文档浏览器-文档数据.js');
const TEMPLATE_PATH = path.join(__dirname, '../templates/browser-template-full.html');

/**
 * 扫描目录下所有 markdown 文件
 */
function scanDocs(dir, baseDir = dir) {
  const docs = [];
  const entries = fs.readdirSync(dir, { withFileTypes: true });

  for (const entry of entries) {
    const fullPath = path.join(dir, entry.name);
    
    if (entry.isDirectory()) {
      docs.push(...scanDocs(fullPath, baseDir));
    } else if (entry.isFile() && entry.name.endsWith('.md')) {
      const relativePath = path.relative(baseDir, fullPath);
      const content = fs.readFileSync(fullPath, 'utf-8');
      
      // 提取标题（第一个 # 标题）
      const titleMatch = content.match(/^#\s+(.+)/m);
      const title = titleMatch ? titleMatch[1].trim() : entry.name.replace('.md', '');
      
      docs.push({
        path: relativePath,
        fullPath,
        title,
        content,
        fileName: entry.name
      });
    }
  }

  return docs;
}

/**
 * 分析项目结构
 */
function analyzeProjectStructure(docs) {
  const structure = {
    projectName: '产品文档',
    hasVersions: false,
    hasFeatures: false,
    hasDecisions: false,
    hasEvolution: false,
    directories: new Set()
  };

  // 提取项目名称（优先级：项目概览 > README > 版本路线图）
  const overviewDoc = docs.find(d => 
    d.path.includes('01-项目概览') || 
    d.path.includes('项目概览') ||
    d.fileName === 'README.md' && d.path.includes('01-')
  );
  
  if (overviewDoc) {
    // 尝试从第一个 # 标题提取项目名
    const titleMatch = overviewDoc.content.match(/^#\s+(.+?)(?:\s|$)/m);
    if (titleMatch) {
      let title = titleMatch[1].trim();
      // 移除常见后缀
      title = title.replace(/(?:项目)?(?:概览|概述|简介|文档|产品文档|PRD|Product|Overview)$/i, '').trim();
      if (title.length > 0 && title.length < 50) {
        structure.projectName = title;
      }
    }
  }

  // 如果还是"产品文档"，尝试从 README.md 提取
  if (structure.projectName === '产品文档') {
    const readmeDoc = docs.find(d => d.fileName === 'README.md' && !d.path.includes('90-'));
    if (readmeDoc) {
      const titleMatch = readmeDoc.content.match(/^#\s+(.+?)(?:\s|$)/m);
      if (titleMatch) {
        let title = titleMatch[1].trim();
        title = title.replace(/(?:项目)?(?:概览|概述|简介|文档|产品文档|PRD|Product|Overview)$/i, '').trim();
        if (title.length > 0 && title.length < 50) {
          structure.projectName = title;
        }
      }
    }
  }
  for (const doc of docs) {
    const parts = doc.path.split(path.sep);
    const firstDir = parts[0];
    
    if (firstDir) {
      structure.directories.add(firstDir);
    }

    // 检查是否有版本相关文档
    if (doc.path.includes('版本') || doc.content.includes('## V') || doc.content.includes('版本路线')) {
      structure.hasVersions = true;
    }

    // 检查是否有功能规格
    if (doc.path.includes('功能规格') || doc.content.match(/V\d+-FR-\d+/)) {
      structure.hasFeatures = true;
    }

    // 检查是否有决策记录
    if (doc.path.includes('决策') || doc.content.match(/D\d{3}/)) {
      structure.hasDecisions = true;
    }

    // 检查是否有演进矩阵
    if (doc.path.includes('演进') || doc.title.includes('演进矩阵')) {
      structure.hasEvolution = true;
    }
  }

  structure.directories = Array.from(structure.directories).sort();

  return structure;
}

/**
 * 从文档中提取版本信息
 */
function extractVersions(docs) {
  const versions = [];
  const versionDocs = docs.filter(d => 
    d.path.includes('版本') || 
    d.title.includes('版本') ||
    d.content.match(/^##\s+V\d+/m)
  );

  const versionSet = new Set();

  for (const doc of versionDocs) {
    const lines = doc.content.split('\n');
    
    // 匹配版本标题：## V1、## V1: 标题、## V1 - 标题
    const versionRegex = /^##\s+(V\d+)[\s:：\-]*(.*)/;
    
    for (const line of lines) {
      const match = line.match(versionRegex);
      if (match) {
        const versionId = match[1];
        const versionName = match[2].trim() || versionId;
        
        if (!versionSet.has(versionId)) {
          versionSet.add(versionId);
          versions.push({
            id: versionId,
            name: versionName,
            label: `${versionId}${versionName ? ': ' + versionName : ''}`,
            kind: determineVersionKind(versionId, doc.content)
          });
        }
      }
    }
  }

  // 如果没有找到版本，至少返回 V1
  if (versions.length === 0) {
    versions.push({
      id: 'V1',
      name: '当前版本',
      label: 'V1: 当前版本',
      kind: 'current'
    });
  }

  return versions.sort((a, b) => {
    const numA = parseInt(a.id.substring(1));
    const numB = parseInt(b.id.substring(1));
    return numA - numB;
  });
}

/**
 * 判断版本类型
 */
function determineVersionKind(versionId, content) {
  const versionNum = parseInt(versionId.substring(1));
  
  if (content.includes('当前版本') || content.includes('正在开发') || versionNum === 1) {
    return 'current';
  }
  if (content.includes('历史') || content.includes('已废弃') || content.includes('归档')) {
    return 'history';
  }
  if (content.includes('规划') || content.includes('后续') || content.includes('未来')) {
    return 'planned';
  }
  
  return 'planned';
}

/**
 * 提取功能列表
 */
function extractFeatures(docs) {
  const features = [];
  const featureDocs = docs.filter(d => 
    d.path.includes('功能规格') || 
    d.path.includes('03-功能规格') ||
    d.content.match(/V\d+-FR-\d+/)
  );

  for (const doc of featureDocs) {
    // 提取功能编号
    const idMatches = doc.content.matchAll(/(V\d+-FR-\d+)/g);
    const ids = new Set();
    
    for (const match of idMatches) {
      ids.add(match[1]);
    }

    if (ids.size === 0) continue;

    const featureId = Array.from(ids)[0]; // 使用第一个匹配的ID
    
    // 提取版本
    const versionMatch = featureId.match(/V(\d+)/);
    const version = versionMatch ? `V${versionMatch[1]}` : 'V1';

    // 判断风险级别
    let risk = 'standard';
    if (doc.content.includes('高风险') || 
        doc.content.includes('需要独立技术设计') ||
/**
 * 提取决策记录（支持 ADR 格式和列表格式）
 */
function extractDecisions(docs) {
  const decisions = [];
  const decisionDocs = docs.filter(d => 
    d.path.includes('决策') || 
    d.path.includes('06-决策记录') ||
    d.path.includes('ADR') ||
    d.content.match(/D\d{3}/)
  );

  for (const doc of decisionDocs) {
    // 格式 1：ADR 格式（## D001 标题）
    const adrRegex = /^##\s+D\d{3}\s+(.+?)$/gm;
    const adrMatches = doc.content.matchAll(adrRegex);
    
    for (const match of adrMatches) {
      const text = match[1].trim();
      if (text.length > 5 && text.length < 150) {
        decisions.push({
          text,
          accent: getDecisionColor(text)
        });
      }
    }

    // 格式 2：列表格式（- 或 * 开头）
    if (decisions.length < 5) {
      const listRegex = /^[-*]\s+(.+?)$/gm;
      const listMatches = doc.content.matchAll(listRegex);
      
      for (const match of listMatches) {
        const text = match[1].trim();
        // 过滤掉明显不是决策的内容
        if (text.length > 20 && text.length < 200 && 
            !text.startsWith('状态：') && 
            !text.startsWith('日期：') && 
            !text.startsWith('背景：') &&
            !text.startsWith('理由：')) {
          decisions.push({
            text,
            accent: getDecisionColor(text)
          });
        }
      }
    }
  }

  // 限制数量并去重
  const uniqueDecisions = Array.from(
    new Map(decisions.map(d => [d.text, d])).values()
  );
  
  return uniqueDecisions.slice(0, 20);
}

/**
 * 根据决策内容分配颜色
 */
function getDecisionColor(text) {
  if (text.includes('V1') || text.includes('当前')) return '#2f7d4f';
  if (text.includes('V2')) return '#a96810';
  if (text.includes('V3') || text.includes('历史')) return '#69707a';
  if (text.includes('支付') || text.includes('计费') || text.includes('V4')) return '#aa2d4d';
  if (text.includes('供给') || text.includes('V5')) return '#4056a1';
  if (text.includes('错误') || text.includes('架构')) return '#aa2d4d';
  return '#087d75';
}

/**
 * 提取能力主线
 */
function extractFeatureTracks(docs) {
  const tracks = {};
  
  const evolutionDoc = docs.find(d => 
    d.path.includes('演进矩阵') || 
    d.path.includes('功能演进') ||
    d.title.includes('演进')
  );

  if (!evolutionDoc) {
    return tracks;
  }

  // 查找能力主线的标题
  const trackRegex = /^###\s+(.+?)(?:演进|能力|主线)/gm;
  const matches = evolutionDoc.content.matchAll(trackRegex);

  const colors = ['#087d75', '#4056a1', '#2f7d4f', '#a96810', '#aa2d4d', '#7c3aed'];
  let colorIndex = 0;

  for (const match of matches) {
    const trackName = match[1].trim();
    const trackId = trackName.toLowerCase()
      .replace(/[^\w\s]/g, '')
      .replace(/\s+/g, '_');

    tracks[trackId] = {
      title: `${trackName}演进`,
      overview: trackName,
      accent: colors[colorIndex % colors.length]
    };
    
    colorIndex++;
  }

  // 如果没有找到能力主线，创建默认的
  if (Object.keys(tracks).length === 0) {
    tracks.core = {
      title: '核心功能演进',
      overview: '核心功能',
      accent: '#087d75'
    };
  }

  return tracks;
}

/**
 * 生成 DOCS 数组（用于侧边栏导航）
 */
function generateDocsArray(docs, versions) {
  const docsArray = [];
  const idMap = new Map();

  // 定义目录颜色映射
  const dirColors = {
    '01-项目概览': { accent: '#087d75', soft: '#dcefeb', phase: '概览' },
    '02-产品与版本': { accent: '#4056a1', soft: '#e6e9f6', phase: '版本' },
    '03-功能规格': { accent: '#2f7d4f', soft: '#e1f0e8', phase: '功能' },
    '04-技术架构': { accent: '#a96810', soft: '#f6ead6', phase: '架构' },
    '05-测试与发布': { accent: '#aa2d4d', soft: '#f4dde4', phase: '测试' },
    '06-决策记录': { accent: '#7c3aed', soft: '#ede9fe', phase: '决策' },
    '90-参考资料': { accent: '#69707a', soft: '#f1eee7', phase: '参考' },
    '99-历史归档': { accent: '#69707a', soft: '#f1eee7', phase: '历史' }
  };

  let idCounter = 0;

  for (const doc of docs) {
    // 跳过浏览器文件本身
    if (doc.fileName.includes('浏览器')) continue;

    const parts = doc.path.split(path.sep);
    const dirName = parts[0] || '其他';
    
    const color = dirColors[dirName] || { 
      accent: '#69707a', 
      soft: '#f1eee7', 
      phase: dirName.replace(/^\d+-/, '') 
    };

    // 提取版本信息
    let version = '00';
    const versionMatch = doc.path.match(/V(\d+)/i) || doc.content.match(/V(\d+)/);
    if (versionMatch) {
      version = `V${versionMatch[1]}`;
    }

    // 提取目标/描述
    const goalMatch = doc.content.match(/##\s*(?:目标|核心目标|概述)\s*\n+(.*?)(?=\n##|\n---|$)/s);
    const goal = goalMatch ? goalMatch[1].trim().substring(0, 80) : '';

    const docId = `doc-${idCounter++}`;
    idMap.set(doc.path, docId);

    docsArray.push({
      id: docId,
      version,
      phase: color.phase,
      accent: color.accent,
      soft: color.soft,
      title: doc.title,
      file: doc.path.replace(/\\/g, '/'),
      goal
    });
  }

  return { docsArray, idMap };
}

/**
 * 生成数据文件
 */
function generateDataFile(docs, idMap) {
  const docData = {};
  
  for (const doc of docs) {
    const docId = idMap.get(doc.path);
    if (docId) {
      docData[docId] = doc.content;
    }
  }

  return `// 生成时间: ${new Date().toISOString()}
// 文档数量: ${docs.length}

window.TUZAI_DOC_BROWSER_DATA = Object.freeze(${JSON.stringify(docData, null, 2)});
`;
}

/**
 * 生成 HTML 文件
 */
function generateHTML(docs, structure, versions, features, decisions, tracks, docsArray) {
  let template = fs.readFileSync(TEMPLATE_PATH, 'utf-8');
  
  // 替换项目名称
  template = template.replace(/TUZAI/g, structure.projectName);
  template = template.replace(/PRD Viewer/g, `${structure.projectName}文档浏览器`);
  
  // 替换 DOCS 数组
  template = template.replace(
    /const DOCS = \[[\s\S]*?\];/,
    `const DOCS = ${JSON.stringify(docsArray, null, 2)};`
  );

  // 替换 DECISIONS 数组
  const decisionsStr = decisions.length > 0 
    ? JSON.stringify(decisions, null, 2)
    : '[]';
  template = template.replace(
    /const DECISIONS = \[[\s\S]*?\];/,
    `const DECISIONS = ${decisionsStr};`
  );

  // 替换 FEATURE_TRACKS
  const tracksStr = Object.keys(tracks).length > 0
    ? JSON.stringify(tracks, null, 2)
    : '{}';
  template = template.replace(
    /const FEATURE_TRACKS = \{[\s\S]*?\};/,
    `const FEATURE_TRACKS = ${tracksStr};`
  );

  // 替换 FEATURE_TIMELINE_VERSIONS
  const timelineVersions = versions.map(v => ({
    id: v.id.toLowerCase(),
    label: v.label,
    kind: v.kind
  }));
  template = template.replace(
    /const FEATURE_TIMELINE_VERSIONS = \[[\s\S]*?\];/,
    `const FEATURE_TIMELINE_VERSIONS = ${JSON.stringify(timelineVersions, null, 2)};`
  );

  // 如果有功能数据，尝试注入 FEATURES 数组（如果模板支持）
  if (features.length > 0 && template.includes('const FEATURES = ')) {
    template = template.replace(
      /const FEATURES = \[[\s\S]*?\];/,
      `const FEATURES = ${JSON.stringify(features, null, 2)};`
    );
  }

  return template;
}

/**
 * 主函数
 */
function main() {
  console.log('🚀 开始生成文档浏览器（v4.0 - 真正定制化版本）...\n');

  if (!fs.existsSync(DOCS_ROOT)) {
    console.error('❌ 错误：docs/ 目录不存在');
    process.exit(1);
  }

  if (!fs.existsSync(TEMPLATE_PATH)) {
    console.error('❌ 错误：浏览器模板不存在');
    console.error(`   路径: ${TEMPLATE_PATH}`);
    process.exit(1);
  }

  // 第一步：扫描文档
  console.log('📂 扫描文档...');
  const docs = scanDocs(DOCS_ROOT);
  console.log(`   找到 ${docs.length} 个文档\n`);

  if (docs.length === 0) {
    console.warn('⚠️  警告：未找到任何 markdown 文档');
    process.exit(0);
  }

  // 第二步：分析项目结构
  console.log('🔍 分析项目结构...');
  const structure = analyzeProjectStructure(docs);
  console.log(`   项目名称: ${structure.projectName}`);
  console.log(`   目录结构: ${structure.directories.join(', ')}`);
  console.log(`   有版本文档: ${structure.hasVersions ? '✓' : '✗'}`);
  console.log(`   有功能规格: ${structure.hasFeatures ? '✓' : '✗'}`);
  console.log(`   有决策记录: ${structure.hasDecisions ? '✓' : '✗'}`);
  console.log(`   有演进矩阵: ${structure.hasEvolution ? '✓' : '✗'}\n`);

  // 第三步：提取版本信息
  console.log('📊 提取版本信息...');
  const versions = extractVersions(docs);
  console.log(`   找到 ${versions.length} 个版本:`);
  versions.forEach(v => {
    const kindLabel = v.kind === 'current' ? '当前' : v.kind === 'history' ? '历史' : '规划';
    console.log(`     - ${v.id}: ${v.name} [${kindLabel}]`);
  });
  console.log();

  // 第四步：提取功能列表
  console.log('📋 提取功能列表...');
  const features = extractFeatures(docs);
  console.log(`   找到 ${features.length} 个功能`);
  if (features.length > 0) {
    const highRisk = features.filter(f => f.risk === 'high').length;
    const done = features.filter(f => f.status === 'done').length;
    console.log(`     - 高风险: ${highRisk} 个`);
    console.log(`     - 已完成: ${done} 个`);
  }
  console.log();

  // 第五步：提取决策记录
  console.log('📝 提取决策记录...');
  const decisions = extractDecisions(docs);
  console.log(`   找到 ${decisions.length} 条决策\n`);

  // 第六步：提取能力主线
  console.log('🎯 提取能力主线...');
  const tracks = extractFeatureTracks(docs);
  const trackCount = Object.keys(tracks).length;
  console.log(`   找到 ${trackCount} 个能力主线`);
  if (trackCount > 0) {
    Object.values(tracks).forEach(t => {
      console.log(`     - ${t.overview}`);
    });
  }
  console.log();

  // 第七步：生成文档数组
  console.log('🔨 生成数据结构...');
  const { docsArray, idMap } = generateDocsArray(docs, versions);
  console.log(`   DOCS 数组: ${docsArray.length} 项`);
  console.log(`   DECISIONS: ${decisions.length} 项`);
  console.log(`   FEATURE_TRACKS: ${Object.keys(tracks).length} 项`);
  console.log(`   FEATURES: ${features.length} 项\n`);

  // 第八步：生成文件
  const outputDir = path.dirname(OUTPUT_HTML);
  if (!fs.existsSync(outputDir)) {
    fs.mkdirSync(outputDir, { recursive: true });
  }

  console.log('📦 生成数据文件...');
  const dataContent = generateDataFile(docs, idMap);
  fs.writeFileSync(OUTPUT_DATA, dataContent, 'utf-8');
  console.log(`   ✅ ${path.relative(process.cwd(), OUTPUT_DATA)}\n`);

  console.log('🎨 生成 HTML 浏览器...');
  const htmlContent = generateHTML(docs, structure, versions, features, decisions, tracks, docsArray);
  fs.writeFileSync(OUTPUT_HTML, htmlContent, 'utf-8');
  console.log(`   ✅ ${path.relative(process.cwd(), OUTPUT_HTML)}\n`);

  // 统计信息
  const htmlSize = (fs.statSync(OUTPUT_HTML).size / 1024).toFixed(1);
  const dataSize = (fs.statSync(OUTPUT_DATA).size / 1024).toFixed(1);
  
  console.log('✨ 生成完成！\n');
  console.log('📊 统计信息：');
  console.log(`   - 项目名称: ${structure.projectName}`);
  console.log(`   - 文档数量: ${docs.length} 个`);
  console.log(`   - 版本数量: ${versions.length} 个`);
  console.log(`   - 功能数量: ${features.length} 个`);
  console.log(`   - 决策记录: ${decisions.length} 条`);
  console.log(`   - 能力主线: ${Object.keys(tracks).length} 个`);
  console.log(`   - HTML 大小: ${htmlSize} KB`);
  console.log(`   - 数据大小: ${dataSize} KB`);
  console.log('\n💡 打开浏览器访问：');
  console.log(`   file://${OUTPUT_HTML}\n`);
  
  console.log('🎉 这是一个真正定制化的浏览器，所有数据都从您的文档中提取！');
}

main();
