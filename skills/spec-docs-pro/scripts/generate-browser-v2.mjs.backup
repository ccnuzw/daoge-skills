/**
 * 生成版本演进 SVG
 */
function generateVersionTimelineSVG(versions, features) {
  if (versions.length === 0) return '';

  const width = 900;
  const height = 200 + versions.length * 80;
  const startX = 50;
  const startY = 100;
  const boxWidth = 160;
  const boxHeight = 60;
  const gap = 40;

  let svg = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" style="max-width: 100%; height: auto;">
  <defs>
    <style>
      .version-box { fill: #e6e9f6; stroke: #4056a1; stroke-width: 2; }
      .version-text { font-family: sans-serif; font-size: 14px; font-weight: 600; fill: #1d1f22; }
      .version-desc { font-family: sans-serif; font-size: 11px; fill: #69707a; }
      .timeline-line { stroke: #c6c1b5; stroke-width: 2; }
      .timeline-arrow { fill: #4056a1; }
    </style>
  </defs>
  
  <text x="${width / 2}" y="40" text-anchor="middle" style="font-size: 18px; font-weight: 700; fill: #1d1f22;">版本演进路线图</text>
  <text x="${width / 2}" y="65" text-anchor="middle" style="font-size: 12px; fill: #69707a;">按时间顺序展示产品版本规划</text>
`;

  // 绘制时间线主线
  const lineX = startX + boxWidth / 2;
  svg += `<line x1="${lineX}" y1="${startY}" x2="${lineX}" y2="${startY + (versions.length - 1) * (boxHeight + gap)}" class="timeline-line" />`;

  // 绘制各个版本
  versions.forEach((version, index) => {
    const y = startY + index * (boxHeight + gap);
    const boxX = startX;
    
    // 版本框
    svg += `<rect x="${boxX}" y="${y}" width="${boxWidth}" height="${boxHeight}" rx="8" class="version-box" />`;
    
    // 版本号
    svg += `<text x="${boxX + boxWidth / 2}" y="${y + 28}" text-anchor="middle" class="version-text">${version.id} ${version.name}</text>`;
    
    // 统计该版本的功能数
  console.log('🔗 提取数据关系...');
  const dataRelationships = extractDataRelationships(docs);
  console.log(`   找到 ${dataRelationships.length} 个表关系\n`);

  console.log('📈 提取功能演进...');
  const featureEvolution = extractFeatureEvolution(docs);
  console.log(`   找到 ${featureEvolution.length} 个能力演进\n`);
    svg += `<text x="${boxX + boxWidth / 2}" y="${y + 48}" text-anchor="middle" class="version-desc">${versionFeatures.length} 个功能</text>`;
    
    // 箭头
    if (index < versions.length - 1) {
      const arrowY = y + boxHeight + gap / 2;
      svg += `<polygon points="${lineX},${arrowY - 5} ${lineX - 5},${arrowY - 12} ${lineX + 5},${arrowY - 12}" class="timeline-arrow" />`;
  const html = generateHTML(docs, '产品文档', versions, features, dataRelationships, featureEvolution);
    
    // 右侧功能列表（最多显示 5 个）
    const displayFeatures = versionFeatures.slice(0, 5);
    displayFeatures.forEach((feature, fIndex) => {
      const featureX = boxX + boxWidth + 30;
      const featureY = y + 15 + fIndex * 18;
      const color = feature.risk === 'high' ? '#aa2d4d' : '#2f7d4f';
      
      svg += `<circle cx="${featureX}" cy="${featureY}" r="3" fill="${color}" />`;
      svg += `<text x="${featureX + 8}" y="${featureY + 4}" style="font-size: 11px; fill: #1d1f22;">${feature.id}: ${feature.title.substring(0, 20)}${feature.title.length > 20 ? '...' : ''}</text>`;
    });
    
    if (versionFeatures.length > 5) {
      svg += `<text x="${boxX + boxWidth + 30}" y="${y + 15 + 5 * 18}" style="font-size: 11px; fill: #69707a;">...还有 ${versionFeatures.length - 5} 个功能</text>`;
    }
  });

  svg += '</svg>';
  return svg;
}

/**
 * 生成风险热区图 SVG
 */
function generateRiskHeatmapSVG(features) {
  if (features.length === 0) return '';

  const highRiskFeatures = features.filter(f => f.risk === 'high');
  const standardFeatures = features.filter(f => f.risk === 'standard');

  const width = 600;
  const height = 300;

  let svg = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" style="max-width: 100%; height: auto;">
  <defs>
    <style>
      .risk-high { fill: #f4dde4; stroke: #aa2d4d; }
      .risk-standard { fill: #e1f0e8; stroke: #2f7d4f; }
      .risk-label { font-family: sans-serif; font-size: 14px; font-weight: 600; fill: #1d1f22; }
      .risk-count { font-family: sans-serif; font-size: 24px; font-weight: 700; }
    </style>
  </defs>
  
  <text x="${width / 2}" y="30" text-anchor="middle" style="font-size: 18px; font-weight: 700; fill: #1d1f22;">功能风险分布</text>
  
  <!-- 高风险 -->
  <rect x="100" y="80" width="180" height="140" rx="8" class="risk-high" stroke-width="2" />
  <text x="190" y="110" text-anchor="middle" class="risk-label">高风险功能</text>
  <text x="190" y="150" text-anchor="middle" class="risk-count" fill="#aa2d4d">${highRiskFeatures.length}</text>
  <text x="190" y="175" text-anchor="middle" style="font-size: 12px; fill: #69707a;">需要独立技术设计</text>
  <text x="190" y="195" text-anchor="middle" style="font-size: 12px; fill: #69707a;">完整的分支追踪</text>
  
  <!-- 标准风险 -->
  <rect x="320" y="80" width="180" height="140" rx="8" class="risk-standard" stroke-width="2" />
  <text x="410" y="110" text-anchor="middle" class="risk-label">标准功能</text>
  <text x="410" y="150" text-anchor="middle" class="risk-count" fill="#2f7d4f">${standardFeatures.length}</text>
  <text x="410" y="175" text-anchor="middle" style="font-size: 12px; fill: #69707a;">功能主文档</text>
  <text x="410" y="195" text-anchor="middle" style="font-size: 12px; fill: #69707a;">基础 AC 覆盖</text>
  
  <text x="${width / 2}" y="260" text-anchor="middle" style="font-size: 11px; fill: #69707a;">高风险功能占比：${((highRiskFeatures.length / features.length) * 100).toFixed(1)}%</text>
</svg>`;

  return svg;
}

/**
 * 生成数据文件
 */
function generateDataFile(docs) {
  const dataContent = `window.DOCS = ${JSON.stringify(docs, null, 2)};`;
  return dataContent;
}

/**
 * 生成 HTML 文件
 */
function generateHTML(docs, projectName = '产品文档', versions, features) {
  let template = fs.readFileSync(TEMPLATE_PATH, 'utf-8');
  
  // 替换项目名称
  template = template.replace(/TUZAI/g, projectName);
  template = template.replace(/PRD Viewer/g, `${projectName}浏览器`);
  
  // 生成图表
  const versionTimelineSVG = generateVersionTimelineSVG(versions, features);
  const riskHeatmapSVG = generateRiskHeatmapSVG(features);
  
  // 在模板中插入图表（查找合适的插入点）
  // 如果模板中有占位符，就替换；否则在特定位置插入
  if (template.includes('<!-- VERSION_TIMELINE_PLACEHOLDER -->')) {
    template = template.replace('<!-- VERSION_TIMELINE_PLACEHOLDER -->', versionTimelineSVG);
  }
  
  if (template.includes('<!-- RISK_HEATMAP_PLACEHOLDER -->')) {
    template = template.replace('<!-- RISK_HEATMAP_PLACEHOLDER -->', riskHeatmapSVG);
  }
  
  // 构建 DOCS 数组
  const docsArray = docs.map((doc, index) => {
    const parts = doc.path.split(path.sep);
    const dirName = parts[0] || '其他';
    
    const colors = {
      '01-项目概览': { accent: '#087d75', soft: '#dcefeb' },
      '02-产品与版本': { accent: '#4056a1', soft: '#e6e9f6' },
      '03-功能规格': { accent: '#2f7d4f', soft: '#e1f0e8' },
      '04-技术架构': { accent: '#a96810', soft: '#f6ead6' },
      '05-测试与发布': { accent: '#aa2d4d', soft: '#f4dde4' },
      '06-决策记录': { accent: '#7c3aed', soft: '#ede9fe' },
      '90-参考资料': { accent: '#69707a', soft: '#f3f4f6' },
      '99-历史归档': { accent: '#8b929a', soft: '#f9fafb' }
    };
    
    const colorScheme = colors[dirName] || { accent: '#69707a', soft: '#f3f4f6' };
    
    return {
      id: index,
      path: doc.path,
      title: doc.title,
      dir: dirName,
      color: colorScheme.accent,
      bgColor: colorScheme.soft
    };
  });
  
  // 在模板中插入 DOCS 定义（如果模板没有加载外部 JS）
  const docsScript = `<script>window.DOCS = ${JSON.stringify(docsArray, null, 2)};</script>`;
  template = template.replace('</head>', `${docsScript}\n</head>`);
  
  return template;
}

/**
 * 主函数
 */
function main() {
  console.log('🚀 开始生成文档浏览器（增强版 v2.0）...\n');

  // 检查 docs 目录
  if (!fs.existsSync(DOCS_ROOT)) {
    console.error('❌ 错误：docs/ 目录不存在');
    process.exit(1);
  }

  // 检查模板
  if (!fs.existsSync(TEMPLATE_PATH)) {
    console.error('❌ 错误：浏览器模板不存在');
    console.error(`   期望位置: ${TEMPLATE_PATH}`);
    process.exit(1);
  }

  console.log('📂 扫描文档...');
  const docs = scanDocs(DOCS_ROOT);
  console.log(`   找到 ${docs.length} 个文档\n`);

  if (docs.length === 0) {
    console.warn('⚠️  警告：未找到任何 markdown 文档');
    process.exit(0);
  }

  console.log('🔍 分析版本演进...');
  const versions = extractVersions(docs);
  console.log(`   找到 ${versions.length} 个版本\n`);

  console.log('📊 提取功能列表...');
  const features = extractFeatures(docs);
  console.log(`   找到 ${features.length} 个功能`);
  console.log(`   - 高风险：${features.filter(f => f.risk === 'high').length} 个`);
  console.log(`   - 标准：${features.filter(f => f.risk === 'standard').length} 个\n`);

  // 确保输出目录存在
  const outputDir = path.dirname(OUTPUT_HTML);
  if (!fs.existsSync(outputDir)) {
    console.log(`📁 创建输出目录: ${outputDir}`);
    fs.mkdirSync(outputDir, { recursive: true });
  }

  console.log('🎨 生成 HTML 浏览器...');
  const html = generateHTML(docs, '产品文档', versions, features);
  fs.writeFileSync(OUTPUT_HTML, html, 'utf-8');
  console.log(`   ✅ ${OUTPUT_HTML}`);

  console.log('📦 生成数据文件...');
  const dataJS = generateDataFile(docs);
  fs.writeFileSync(OUTPUT_DATA, dataJS, 'utf-8');
  console.log(`   ✅ ${OUTPUT_DATA}`);

  // 统计
  const htmlSize = (fs.statSync(OUTPUT_HTML).size / 1024).toFixed(1);
  const dataSize = (fs.statSync(OUTPUT_DATA).size / 1024).toFixed(1);

  console.log('\n✨ 生成完成！\n');
  console.log('📊 统计信息：');
  console.log(`   - 文档数量：${docs.length} 个`);
  console.log(`   - 版本数量：${versions.length} 个`);
  console.log(`   - 功能数量：${features.length} 个`);
  console.log(`   - HTML 大小：${htmlSize} KB`);
  console.log(`   - 数据大小：${dataSize} KB`);
  console.log('\n💡 使用方式：');
  console.log(`   用浏览器打开：${OUTPUT_HTML}`);
  console.log(`   或者运行：npx http-server docs/90-参考资料/`);
}

// 运行
main();
