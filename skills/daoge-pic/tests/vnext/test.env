# Regression runs must never touch the real OS credential store.
#
# The default backend (`auto`) prefers the platform secret store, which is what
# we want in production — but a test suite that writes into the user's actual
# macOS Keychain / DPAPI / libsecret would leave residue behind and would fail
# outright inside a sandbox. Tests pin the plaintext backend and exercise the
# system backends explicitly (see tests/vnext/provider-secrets.test.js).
DAOGE_PIC_PROVIDER_SECRET_BACKEND=plaintext

# The transport honours HTTP_PROXY / HTTPS_PROXY / NO_PROXY. Many developer and
# agent environments export a transparent proxy (127.0.0.1 on some port), which
# would silently reroute every Provider test through it and defeat the DNS
# pinning assertions. Tests start from "no proxy" and opt in explicitly.
http_proxy=
https_proxy=
HTTP_PROXY=
HTTPS_PROXY=
all_proxy=
ALL_PROXY=
no_proxy=
NO_PROXY=
