{
  "root": "{{文档目录}}",
  "tier": "m",
  "activeVersion": "{{活跃版本}}",
  "projectName": "{{项目名}}",
  "phase": "planning",
  "openapi": "04-技术架构/当前版本/{{活跃版本}}-openapi.yaml",
  "requireDeliveryMetadata": true,
  "versionPlanning": {
    "enabled": true,
    "roadmap": "02-产品与版本/版本路线图.md",
    "index": "02-产品与版本/后续版本/README.md",
    "directory": "02-产品与版本/后续版本",
    "filePattern": "^(V\\d+)(?:-.+)?\\.md$",
    "planningStatuses": ["规划骨架", "门禁评审中"],
    "activeVersionExempt": true,
    "requireIndexLink": true,
    "requiredSections": ["版本目标", "范围与边界", "架构与接口方向", "数据影响", "验收方向"]
  },
  "quality": {
    "enabled": true,
    "strict": true,
    "allowNotApplicable": true,
    "minimumInterfaceTables": ["接口清单", "OpenAPI operation 映射", "错误矩阵"],
    "minimumDataSections": ["涉及数据", "约束与事务", "字段读写矩阵", "状态与生命周期", "物理约束与迁移", "数据所有权", "安全与保留"],
    "requiredMetadata": ["title", "version", "feature_id", "domain", "updated", "delivery_scope", "planning_only", "delivery_slice"],
    "requireFeatureTitle": true,
    "requireSourceTrace": true,
    "traceability": {
      "enabled": true,
      "requireFeatureLink": true,
      "requireMappedColumns": ["需求范围", "关键接口", "关键数据", "跨功能验收"],
      "requireE2eResolution": true
    },
    "technicalDesign": {
      "enabled": true,
      "requiredSections": ["单元契约", "伪代码", "分支到测试追踪", "约束备注"],
      "requireFeatureId": true,
      "requireSourceFeature": true,
      "requireBranchAcMapping": true
    },
    "e2e": {
      "enabled": true,
      "matrix": "05-测试与发布/端到端验收/用例矩阵.md",
      "requiredColumns": ["真实入口", "必须真实的本系统依赖", "最终业务断言", "目标测试文件", "当前证据状态"],
      "requireReferencedIds": true
    },
    "performance": {
      "enabled": true,
      "matrix": "05-测试与发布/性能与容量/场景矩阵.md",
      "requiredColumns": ["目标", "最低环境", "关键断言", "必要证据", "当前状态"]
    },
    "adr": {
      "enabled": true,
      "directory": "06-决策记录/ADR",
      "excludePattern": "^0001-决策标题\\.md$",
      "requiredSections": ["背景", "备选方案", "决策", "后果", "验证"]
    }
  },
  "sections": [
    "01-项目概览",
    "02-产品与版本",
    "03-功能规格",
    "04-技术架构",
    "05-测试与发布",
    "06-决策记录",
    "90-参考资料",
    "99-历史归档"
  ],
  "required": [
    "README.md",
    "01-项目概览/README.md",
    "01-项目概览/工程与本地环境.md",
    "01-项目概览/Git提交信息规范.md",
    "02-产品与版本/README.md",
    "02-产品与版本/版本规格说明.md",
    "02-产品与版本/产品蓝图.md",
    "02-产品与版本/版本路线图.md",
    "02-产品与版本/全版本产品与交互约束.md",
    "02-产品与版本/版本进入开发门禁.md",
    "02-产品与版本/当前版本/{{活跃版本}}-版本总览.md",
    "02-产品与版本/当前版本/{{活跃版本}}-产品需求.md",
    "02-产品与版本/当前版本/{{活跃版本}}-实现状态.md",
    "03-功能规格/README.md",
    "03-功能规格/功能开发流程.md",
    "03-功能规格/功能文档规范.md",
    "03-功能规格/{{活跃版本}}/README.md",
    "03-功能规格/{{活跃版本}}/00-{{活跃版本}}需求编号.md",
    "03-功能规格/{{活跃版本}}/00-{{活跃版本}}需求追踪矩阵.md",
    "03-功能规格/{{活跃版本}}/功能查找表.md",
    "03-功能规格/{{活跃版本}}/功能风险分级.md",
    "03-功能规格/{{活跃版本}}/技术设计索引.md",
    "04-技术架构/README.md",
    "04-技术架构/总体架构.md",
    "04-技术架构/统一错误码.md",
    "04-技术架构/当前版本/{{活跃版本}}-总体架构.md",
    "04-技术架构/当前版本/{{活跃版本}}-接口契约.md",
    "04-技术架构/当前版本/{{活跃版本}}-openapi.yaml",
    "04-技术架构/当前版本/{{活跃版本}}-数据模型.md",
    "05-测试与发布/README.md",
    "05-测试与发布/测试策略.md",
    "05-测试与发布/安全基线.md",
    "05-测试与发布/证据报告规范.md",
    "05-测试与发布/端到端验收/README.md",
    "05-测试与发布/端到端验收/{{活跃版本}}-端到端验收规范.md",
    "05-测试与发布/端到端验收/环境说明.md",
    "05-测试与发布/端到端验收/测试夹具.md",
    "05-测试与发布/端到端验收/执行手册.md",
    "05-测试与发布/端到端验收/用例矩阵.md",
    "05-测试与发布/端到端验收/验证证据.md",
    "05-测试与发布/端到端验收/报告/README.md",
    "05-测试与发布/性能与容量/README.md",
    "05-测试与发布/性能与容量/场景矩阵.md",
    "05-测试与发布/发布/README.md",
    "05-测试与发布/发布/检查清单.md",
    "05-测试与发布/发布/部署手册.md",
    "05-测试与发布/发布/回滚手册.md",
    "05-测试与发布/发布/恢复手册.md",
    "06-决策记录/README.md",
    "06-决策记录/{{活跃版本}}-冻结决策.md",
    "06-决策记录/{{活跃版本}}-文档变更记录.md",
    "06-决策记录/ADR/README.md",
    "99-历史归档/README.md"
  ],
  "featureDoc": {
    "dir": "03-功能规格/{{活跃版本}}",
    "filePattern": "^\\d{2}-.+\\.md$",
    "excludePattern": "(^00-)|(^README\\.md$)|(-技术设计\\.md$)",
    "sections": [
      "目标",
      "功能边界",
      "需求说明",
      "接口契约",
      "数据与事务",
      "验收标准",
      "实现与验证"
    ],
    "statusValues": ["规划中", "开发中", "部分实现", "基础实现", "本地验证", "待验收", "已完成", "阻塞"],
    "acColumns": ["测试层级", "目标资产", "目标命令"]
  },
  "ids": {
    "requirement": "V\\d+-FR-\\d{3}",
    "nfr": "V\\d+-NFR-\\d{3}",
    "releaseGate": "V\\d+-RG-\\d{3}",
    "e2e": "V\\d+-E2E-\\d{2}[A-Z]?",
    "acceptance": "AC\\d{2}",
    "branch": "B\\d+-\\d{2}",
    "decision": "D\\d{3}"
  },
  "indexes": [
    "03-功能规格/{{活跃版本}}/README.md",
    "03-功能规格/{{活跃版本}}/功能查找表.md",
    "03-功能规格/{{活跃版本}}/技术设计索引.md"
  ],
  "traceability": [
    "03-功能规格/{{活跃版本}}/00-{{活跃版本}}需求编号.md",
    "03-功能规格/{{活跃版本}}/00-{{活跃版本}}需求追踪矩阵.md"
  ],
  "warnOnPlaceholders": true,
  "ignoreLinksIn": ["90-参考资料"],
  "strict": false
}
