{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src/vnext",
    "outDir": "dist/vnext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/vnext/**/*.ts"]
}
