{
  "protocol": "daoge-pic-skill-protocol",
  "version": "3.1.0",
  "runtimeCompatibility": ">=6.0.0 <7.0.0",
  "gates": [
    "human-confirmation-challenge",
    "daemon-confirm-token",
    "preflight-binding",
    "agent-only-run-creation",
    "single-run-per-round"
  ],
  "transport": [
    "json",
    "stdin-json-marker"
  ],
  "idempotency": [
    "operation-name",
    "idempotency-key"
  ]
}
