{
  "name": "daoge-pic",
  "version": "5.14.2",
  "description": "DAOGE Pic vNext conversation-first local image creation Studio.",
  "main": "dist/vnext/cli/daoge.js",
  "bin": {
    "daoge": "scripts/daoge.js"
  },
  "files": [
    "dist/vnext/",
    "dist/workbench/",
    "scripts/daoge.js",
    "references/provider.env.example",
    "docs/daoge_pic_vnext_upgrade_spec_zh.md",
    "docs/vnext_verification_evidence_zh.md",
    "README.md",
    "SKILL.md",
    "protocol-version.json",
    "LICENSE"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "typecheck:vnext": "tsc -p tsconfig.vnext.json --noEmit",
    "build:vnext": "npm run typecheck:vnext && node scripts/build-vnext.js",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:workbench": "npm run typecheck:web && vite build --config vite.workbench.config.mjs",
    "build": "npm run build:vnext && npm run build:workbench",
    "bench:perf": "npm run build:vnext && node scripts/bench-perf.js",
    "test:vnext": "npm run build && node scripts/run-tests.js",
    "test": "npm run test:vnext",
    "test:package": "npm run build && npm pack --ignore-scripts --pack-destination . && node scripts/package-smoke.js --require-release-artifact",
    "verify:evidence": "node scripts/verification-evidence.js",
    "verify:evidence:check": "node scripts/verification-evidence.js --check",
    "prepack": "npm run build",
    "lint": "eslint src/vnext web/src tests",
    "lint:fix": "eslint src/vnext web/src tests --fix"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.4"
  },
  "types": "./dist/vnext/cli/daoge.d.ts"
}
