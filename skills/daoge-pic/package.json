{
  "name": "daoge-pic",
  "version": "5.10.3",
  "description": "DAOGE Pic vNext conversation-first local image creation Studio.",
  "main": "dist/vnext/cli/daoge.js",
  "bin": {
    "daoge": "scripts/daoge.js"
  },
  "files": [
    "dist/",
    "scripts/daoge.js",
    "references/provider.env.example",
    "docs/daoge_pic_vnext_upgrade_spec_zh.md",
    "docs/vnext_verification_evidence_zh.md",
    "README.md",
    "SKILL.md",
    "protocol-version.json",
    "LICENSE"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:vnext": "node -e \"require('node:fs').rmSync('dist/vnext', { recursive: true, force: true })\" && tsc -p tsconfig.vnext.json",
    "build:workbench": "vite build --config vite.workbench.config.mjs",
    "build": "npm run build:vnext && npm run build:workbench",
    "bench:perf": "npm run build:vnext && node scripts/bench-perf.js",
    "test:vnext": "npm run build && node --test tests/vnext/*.test.js",
    "test": "npm run test:vnext",
    "test:package": "npm run build && node scripts/package-smoke.js",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.4"
  },
  "types": "./dist/vnext/cli/daoge.d.ts"
}
